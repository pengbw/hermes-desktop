{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Desktop",
  "version": "0.2.0",
  "identifier": "com.hermes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/download-hermes-source.cjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Hermes Desktop",
        "label": "main",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true,
        "decorations": true
      },
      {
        "title": "Hermes Avatar",
        "label": "avatar",
        "url": "index.html",
        "width": 350,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "x": 100,
        "y": 100
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:hermes.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "hermes-agent-source/": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
